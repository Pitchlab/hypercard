{
  "name": "hypercard",
  "version": "0.1.0",
  "description": "CLI tool that turns markdown files into a queryable knowledge graph with hybrid search",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "hypercard": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "chokidar": "^3.6.0",
    "commander": "^12.0.0",
    "glob": "^10.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "license": "MIT"
}
